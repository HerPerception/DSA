package main

// First implementation. My logic. Debugging assisted by AI. 3ms runtime and 7.15MB memory use.
func countKeyChanges(s string) int {
    keyMap := make(map[rune]int)
    count := 0
    for  _, ch := range s {
        if ch >= 'A' && ch <= 'Z' {
            ch += 32
        }
        if _, exists := keyMap[ch]; exists {
            keyMap[ch]++
        } else {
            keyMap = make(map[rune]int)
            keyMap[ch] = 1
            count += 1
        }
    }
    return count - 1
}
